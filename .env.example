# 複製為 .env 後填入。行程裡已有的變數優先，部署用平台注入即可。
# 產生 JWT_SECRET：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Docker 部署預設從 Gitea 建立的 grid_oauth_config volume 自動讀取。
GITEA_OAUTH_CONFIG_FILE=/run/grid-oauth/client.json
# 不使用自動 provisioning 時，才自行設定以下五個值覆蓋設定檔：
# GITEA_INTERNAL_URL=http://gridplusplus-git:3000
# GITEA_PUBLIC_URL=http://127.0.0.1:6733
# GITEA_OAUTH_CLIENT_ID=
# GITEA_OAUTH_CLIENT_SECRET=
# GITEA_OAUTH_REDIRECT_URI=http://localhost:8000/auth/gitea/callback
# HTTP 本機開發設 false；正式 HTTPS 可省略（會依 Redirect URI 自動啟用）。
# OAUTH_COOKIE_SECURE=false

# 預設為專案根目錄的 grid_platform.db
# DATABASE_URL=sqlite:///./grid_platform.db

# 本機開 http://127.0.0.1:8000/ 用內建前端時不需要。
# 前端在別的 origin 才設，逗號分隔，不可用 *
# CORS_ORIGINS=http://localhost:5500

# 外層 nginx 與 Gitea 所在的既有 Docker network；預設為 nginx，正式環境不需設定。
# 平台必須接上這個 network，才能以 http://gridplusplus-git:3000 向 Gitea 換取 OAuth token。
# EDGE_NETWORK=nginx

# 本機開發另外對 127.0.0.1:8000 發布 port（正式環境不要加）：
# Windows: COMPOSE_FILE=docker-compose.yml;docker-compose.dev.yml
# Linux:   COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
